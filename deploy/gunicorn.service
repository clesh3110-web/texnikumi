[Unit]
Description=Gunicorn for Guliston Texnikum
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/guliston_texnikum
RuntimeDirectory=guliston
RuntimeDirectoryMode=0755
ExecStart=/var/www/guliston_texnikum/venv/bin/gunicorn --workers 3 --timeout 120 --bind unix:/run/guliston/gunicorn.sock config.wsgi:application
Restart=on-failure
RestartSec=5
UMask=007

[Install]
WantedBy=multi-user.target
